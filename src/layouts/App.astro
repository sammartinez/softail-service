---
/* The shell: head, header, bottom nav, timer bar, footer.

   Same ids and classes as the vanilla build had, because styles.css addresses
   them by name and the responsive rules key off them. */
import { BIKE } from "@data/jobs";
import { VIEWS } from "@lib/state";
import { NAV } from "@lib/icons";
import "../styles/styles.css";

/* Public files are linked through the base, not relative to the page: opened
   at the dev server's bare "/", a relative "sw.js" asks for /sw.js, which is
   outside the base and fails. */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const views = Object.keys(VIEWS) as (keyof typeof NAV)[];
const label: Record<string, string> = {
  due: "Due", jobs: "Jobs", shop: "Shop", log: "Log", ref: "Specs",
};
---

<!doctype html>
<html lang="en" data-fuel="carb">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#F8FAFC" />
<meta name="description" content="Maintenance reference for a 2003 Harley-Davidson Heritage Softail Classic, built from the Softail 2000-2005 service manual." />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Softail" />
<title>Softail Service · 2003 Heritage</title>
<link rel="manifest" href={base + "manifest.webmanifest"} />
<link rel="icon" href={base + "favicon-32.png"} sizes="32x32" type="image/png" />
<link rel="icon" href={base + "favicon.svg"} type="image/svg+xml" />
<link rel="apple-touch-icon" href={base + "icon-180.png"} />
</head>
<body>

<div class="wrap">

  <header class="top">
    <p class="kicker" id="bikeLine">{BIKE.year} {BIKE.name} · {BIKE.engine} · <span id="fuelLabel">Carb</span></p>
    <h1 id="viewTitle" tabindex="-1">What's due</h1>
    <p class="odo" id="odoLine"></p>
  </header>

  <main>
    <slot />
  </main>

  <footer class="card flat xs muted" style="margin-bottom:18px">
    <p style="margin:0">Figures come from the Clymer <i>Harley-Davidson Softail 2000-2005</i> service manual, for a 2003 FLSTC. Steps here are shortened for the garage; the manual is the authority. Part picks and store links are not from the manual.</p>
  </footer>
</div>

<div class="timerbar" id="timerBar" hidden></div>
<p class="sr" id="announce" aria-live="assertive"></p>

<nav class="bar" aria-label="Views">
  <p class="brand" aria-hidden="true">Softail Service</p>
  <div class="inner">
    {views.map((v, i) => (
      <button data-view={v} aria-current={i === 0 ? "page" : undefined}>
        <Fragment set:html={NAV[v]} />{label[v]}
      </button>
    ))}
  </div>
</nav>

<script>
  import { init } from "../scripts/boot";
  init();
</script>
</body>
</html>
